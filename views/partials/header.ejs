<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Litera</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainMenu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'home' ? 'active' : '' %>" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'books' ? 'active' : '' %>" href="/books">Books</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'contacts' ? 'active' : '' %>" href="/contacts">Contacts</a>
                    </li>
                </ul>
                <% if (typeof username !== 'undefined' && username !== 'guest') { %>
                    <span class="navbar-text text-light ms-3">Вітаємо, <%= username %></span>
                    <form method="POST" action="/logout" class="d-flex ms-2">
                        <button type="submit" class="btn btn-outline-light btn-sm">Вийти</button>
                    </form>
                <% } else { %>
                    <span class="navbar-text text-secondary ms-3">Гість</span>
                    <a class="btn btn-outline-light btn-sm ms-2" href="/login">Вхід</a>
                <% } %>
            </div>
        </div>
    </nav>
</header>
