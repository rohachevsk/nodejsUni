<section class="container py-5" style="max-width: 480px;">
    <h1 class="mb-4">Вхід</h1>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>
    <form method="POST" action="/login" class="card card-body shadow-sm">
        <div class="mb-3">
            <label class="form-label" for="username">Імʼя</label>
            <input class="form-control" id="username" name="username" required autocomplete="username">
        </div>
        <button type="submit" class="btn btn-primary">Увійти</button>
    </form>
</section>
