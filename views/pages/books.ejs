<section class="container py-4">
    <p class="text-uppercase text-secondary mb-2">Каталог</p>
    <h1 class="mb-4">Книги</h1>

    <div class="row g-4">
        <% if (typeof books !== 'undefined' && books.length) { %>
            <% books.forEach((book, index) => { %>
                <% const fallbackCover = `/photo${(index % 3) + 1}.jpg`; %>
                <% const cover = book.image ? `/images/${encodeURIComponent(book.image)}` : fallbackCover; %>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <img src="<%= cover %>" class="card-img-top" alt="<%= book.title %>" style="height: 220px; object-fit: cover;" loading="lazy" onerror="this.onerror=null;this.src='<%= fallbackCover %>';">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><%= book.title %></h5>
                            <% if (book.description) { %>
                                <p class="card-text"><%= book.description %></p>
                            <% } %>
                            <% if (book.price !== undefined && book.price !== null) { %>
                                <p class="fw-bold mb-2"><%= book.price %> ₴</p>
                            <% } %>
                            <% if (book.genre || book.year) { %>
                                <p class="text-muted small mb-2"><%= [book.genre, book.year].filter(Boolean).join(' · ') %></p>
                            <% } %>
                            <button class="btn btn-primary mt-auto">Подробнее</button>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p>Книги не найдены.</p>
        <% } %>
    </div>
</section>
